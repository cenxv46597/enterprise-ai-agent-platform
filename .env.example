EAAP_APP_NAME=Enterprise AI Agent Platform
EAAP_APP_ENV=local
# 网页请求的精确来源：生产环境需显式设置 HTTPS origin，不带路径或末尾斜杠。
EAAP_WEB_ORIGIN=http://127.0.0.1:5173
# 登录令牌签名密钥：生产环境必须配置至少 32 字符；真实值只放在被 Git 忽略的 .env。
# 本地/测试留空时每次应用启动随机生成，重启后已有令牌失效；需要跨重启登录可在本机配置。
EAAP_JWT_SECRET_KEY=
# 首次启动前生成本机独立口令；真实值只放在被 Git 忽略的 .env。
# 本机生成使用 URL 安全字符，避免连接地址中的保留字符需要额外编码。
EAAP_POSTGRES_PASSWORD=
EAAP_DATABASE_URL=postgresql+psycopg://eaap:${EAAP_POSTGRES_PASSWORD}@127.0.0.1:5432/eaap
EAAP_TEST_DATABASE_URL=postgresql+psycopg://eaap:${EAAP_POSTGRES_PASSWORD}@127.0.0.1:5432/eaap_test
EAAP_MAX_UPLOAD_BYTES=5242880

# 首个向量模型已选定；密钥与接口地址由本机配置，勿提交 .env。
EAAP_EMBEDDING_MODEL=text-embedding-v4
EAAP_EMBEDDING_DIMENSIONS=1024
# 从百炼控制台复制对应地域/业务空间的兼容地址，末尾为 /compatible-mode/v1。
EAAP_EMBEDDING_BASE_URL=
EAAP_EMBEDDING_API_KEY=
EAAP_EMBEDDING_BATCH_SIZE=10
EAAP_EMBEDDING_TIMEOUT_SECONDS=30
EAAP_EMBEDDING_TOTAL_TIMEOUT_SECONDS=120
EAAP_EMBEDDING_MAX_CHUNKS=200

# 首个回答模型已选定为 DeepSeek 官网的 deepseek-flash；与向量服务分别配置。
# 代码会在基础地址后添加 /chat/completions；新密钥只放在本机 .env。
EAAP_GENERATION_BASE_URL=https://api.deepseek.com
EAAP_GENERATION_API_KEY=
EAAP_GENERATION_MODEL=deepseek-flash
EAAP_GENERATION_TIMEOUT_SECONDS=30
EAAP_GENERATION_TOTAL_TIMEOUT_SECONDS=60
EAAP_GENERATION_MAX_TOKENS=2000
# 仅限制证据正文的字符数，不等于模型的 token 上限。
EAAP_GENERATION_MAX_CONTEXT_CHARACTERS=12000

# 可选重排复用上述生成服务；接口请求 rerank=true 才启用。
# 有候选时至多增加一次模型请求，不自动重试；正文最多 20000 字符。
EAAP_RERANK_TIMEOUT_SECONDS=15
EAAP_RERANK_TOTAL_TIMEOUT_SECONDS=20
EAAP_RERANK_MAX_TOKENS=512

# 智能体动作决策复用生成服务；只有调用 /agent-runs 才运行。
# max_steps 控制决策次数；默认原生工具调用，json 可显式切换到旧动作协议。
# DeepSeek 官网原生决策显式关闭思考模式；失败不会自动改协议或重试。
EAAP_AGENT_PROTOCOL=native
EAAP_AGENT_TIMEOUT_SECONDS=15
EAAP_AGENT_TOTAL_TIMEOUT_SECONDS=20
EAAP_AGENT_MAX_TOKENS=512

# /agent-runs 显式 search_backend=mcp 时使用固定本地只读进程；不开放任意命令/地址。
# 连接、发现和调用的取消预算；SDK 进程清理可能额外消耗有界宽限时间。
EAAP_MCP_TOOL_TIMEOUT_SECONDS=30

# 可选的离线模型评审，只有显式执行 --run 时才使用；不自动借用回答服务配置。
# 可以手动选择与回答服务相同的接口和模型，结果仍属于 AI 辅助建议。
EAAP_REVIEW_BASE_URL=
EAAP_REVIEW_API_KEY=
EAAP_REVIEW_MODEL=
EAAP_REVIEW_TIMEOUT_SECONDS=30
EAAP_REVIEW_TOTAL_TIMEOUT_SECONDS=60
EAAP_REVIEW_MAX_TOKENS=3000
