EAAP_APP_NAME=Enterprise AI Agent Platform
EAAP_APP_ENV=local
EAAP_DATABASE_URL=postgresql+psycopg://eaap:eaap_local_only@127.0.0.1:5432/eaap
EAAP_MAX_UPLOAD_BYTES=5242880

# 首个向量模型已选定；密钥与接口地址由本机配置，勿提交 .env。
EAAP_EMBEDDING_MODEL=text-embedding-v4
EAAP_EMBEDDING_DIMENSIONS=1024
# 从百炼控制台复制对应地域/业务空间的兼容地址，末尾为 /compatible-mode/v1。
EAAP_EMBEDDING_BASE_URL=
EAAP_EMBEDDING_API_KEY=
EAAP_EMBEDDING_BATCH_SIZE=10
EAAP_EMBEDDING_TIMEOUT_SECONDS=30
EAAP_EMBEDDING_TOTAL_TIMEOUT_SECONDS=120
EAAP_EMBEDDING_MAX_CHUNKS=200

# 文本生成与向量生成使用独立配置；模型名称从已购平台控制台确认。
# 基础地址应由平台提供；代码会在其后添加 /chat/completions。
EAAP_GENERATION_BASE_URL=
EAAP_GENERATION_API_KEY=
EAAP_GENERATION_MODEL=
EAAP_GENERATION_TIMEOUT_SECONDS=30
EAAP_GENERATION_TOTAL_TIMEOUT_SECONDS=60
EAAP_GENERATION_MAX_TOKENS=2000
# 仅限制证据正文的字符数，不等于模型的 token 上限。
EAAP_GENERATION_MAX_CONTEXT_CHARACTERS=12000
